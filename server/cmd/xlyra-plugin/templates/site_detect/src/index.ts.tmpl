import type { DetectContext, ProbeStep, SiteDetectDecision } from "../types/xlyra";

export const meta = { apiVersion: 1, id: "{{.ID}}", kind: "site_detect" };

// No credential is available here: requests go out without Authorization, so
// only use public endpoints.
export function detect(_ctx: DetectContext, steps: ProbeStep[]): SiteDetectDecision {
  if (steps.length === 0) {
    return { request: { method: "GET", path: "/api/status" } };
  }
  const resp = steps[0].response;
  const matched = resp.status === 200 && resp.json?.system_name === "Acme Relay";
  if (!matched) return { result: { matched: false } };
  // siteType must be a type xLyra already supports; it tells xLyra how to talk to the site.
  return { result: { matched: true, siteType: "newapi", confidence: 0.95, features: { version: String(resp.json.version ?? "") } } };
}
