          "contents",
          "systemInstruction",
          "tools",
          "toolConfig",
          "generationConfig",
          "safetySettings"
        ]
      },
      "capabilities": {
        "text_delta": true,
        "tool_calls": true,
        "usage": true,
        "image_generation": true,
        "thinking": true
      },
      "reasoning": {
        "default": "metadata",
        "thinking": "metadata",
        "thinking_signature": "strip"
      }
