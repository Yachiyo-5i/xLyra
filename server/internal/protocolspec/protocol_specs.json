{
  "version": 1,
  "protocols": {
    "openai_chat": {
      "events": {
        "created": {
          "name": "chat.completion.chunk",
          "data_path": "choices[].delta.role"
        },
        "text_delta": {
          "name": "chat.completion.chunk",
          "delta_path": "choices[].delta.content"
        },
        "tool_call_delta": {
          "name": "chat.completion.chunk",
          "delta_path": "choices[].delta.tool_calls[].function.arguments"
        },
        "usage": {
          "name": "chat.completion.chunk",
          "data_path": "usage"
        },
        "completed": {
          "name": "chat.completion.chunk",
          "data_path": "choices[].finish_reason"
        },
        "incomplete": {
          "name": "chat.completion.chunk",
          "data_path": "choices[].finish_reason"
        },
        "error": {
          "name": "error"
        }
      },
      "param_mappings": [
        {
          "canonical": "stream",
          "upstream": "stream"
        },
        {
          "canonical": "stream_options",
          "upstream": "stream_options"
        },
        {
          "canonical": "temperature",
          "upstream": "temperature"
        },
        {
          "canonical": "top_p",
          "upstream": "top_p"
        },
        {
          "canonical": "parallel_tool_calls",
          "upstream": "parallel_tool_calls"
        },
        {
          "canonical": "metadata",
          "upstream": "metadata"
        },
        {
          "canonical": "user",
          "upstream": "user"
        }
      ],
      "request_params": {
        "supported": [
          "model",
          "messages",
          "stream",
          "stream_options",
          "temperature",
          "top_p",
          "max_tokens",
          "max_completion_tokens",
          "tools",
          "tool_choice",
          "parallel_tool_calls",
          "response_format",
          "metadata",
          "user",
          "stop"
        ],
        "validation": {
          "temperature": {"type": "number", "min": 0, "max": 2},
          "top_p": {"type": "number", "min": 0, "max": 1},
          "max_tokens": {"type": "integer", "min": 1},
          "max_completion_tokens": {"type": "integer", "min": 1}
        }
      },
      "capabilities": {
        "text_delta": true,
        "tool_calls": true,
        "usage": true,
        "refusal": false,
        "reasoning_summary": false,
        "encrypted_reasoning": false,
        "thinking": false,
        "thinking_signature": false,
        "advanced_tool_events": false
      },
      "reasoning": {
        "default": "metadata",
        "encrypted_reasoning": "strip",
        "reasoning_summary": "metadata",
        "thinking": "passthrough",
        "thinking_signature": "passthrough"
      }
    },
    "openai_responses": {
      "events": {
        "created": {
          "name": "response.created"
        },
        "response_in_progress": {
          "name": "response.in_progress"
        },
        "text_delta": {
          "name": "response.output_text.delta",
          "delta_path": "delta"
        },
        "text_done": {
          "name": "response.output_text.done",
          "data_path": "text"
        },
        "refusal_delta": {
          "name": "response.refusal.delta",
          "delta_path": "delta"
        },
        "annotation_added": {
          "name": "response.output_text.annotation.added",
          "data_path": "annotation"
        },
        "tool_call_delta": {
          "name": "response.function_call_arguments.delta",
          "delta_path": "delta"
        },
        "tool_call_arguments_done": {
          "name": "response.function_call_arguments.done",
          "data_path": "arguments"
        },
        "output_item_added": {
          "name": "response.output_item.added",
          "data_path": "item"
        },
        "output_item_done": {
          "name": "response.output_item.done",
          "data_path": "item"
        },
        "content_part_added": {
          "name": "response.content_part.added",
          "data_path": "part"
        },
        "content_part_done": {
          "name": "response.content_part.done",
          "data_path": "part"
        },
        "usage": {
          "name": "response.completed",
          "data_path": "response.usage"
        },
        "completed": {
          "name": "response.completed"
        },
        "incomplete": {
          "name": "response.incomplete"
        },
        "error": {
          "name": "response.error"
        },
        "reasoning_delta": {
          "name": "response.reasoning_delta",
          "delta_path": "delta"
        },
        "reasoning_summary_delta": {
          "name": "response.reasoning_summary.delta",
          "delta_path": "delta"
        },
        "encrypted_reasoning_delta": {
          "name": "response.reasoning.encrypted_content.delta",
          "delta_path": "delta"
        },
        "encrypted_reasoning_done": {
          "name": "response.reasoning.encrypted_content.done"
        },
        "advanced_event": {
          "name": "response.*",
          "data_path": "$"
        },
        "tool_result": {
          "name": "response.output_item.*",
          "data_path": "item"
        },
        "mcp_event": {
          "name": "response.mcp_*",
          "data_path": "$"
        },
        "approval_event": {
          "name": "response.approval_*",
          "data_path": "$"
        },
        "computer_event": {
          "name": "response.computer_call.*",
          "data_path": "$"
        },
        "image_partial": {
          "name": "response.image_generation_call.partial_image",
          "data_path": "$"
        }
      },
      "param_mappings": [
        {
          "canonical": "stream",
          "upstream": "stream"
        },
        {
          "canonical": "stream_options",
          "upstream": "stream_options"
        },
        {
          "canonical": "temperature",
          "upstream": "temperature"
        },
        {
          "canonical": "top_p",
          "upstream": "top_p"
        },
        {
          "canonical": "metadata",
          "upstream": "metadata"
        },
        {
          "canonical": "user",
          "upstream": "user"
        },
        {
          "canonical": "store",
          "upstream": "store"
        },
        {
          "canonical": "parallel_tool_calls",
          "upstream": "parallel_tool_calls"
        },
        {
          "canonical": "service_tier",
          "upstream": "service_tier"
        }
      ],
      "request_params": {
        "supported": [
          "model",
          "input",
          "instructions",
          "stream",
          "stream_options",
          "temperature",
          "top_p",
          "max_output_tokens",
          "tools",
          "tool_choice",
          "parallel_tool_calls",
          "text",
          "reasoning",
          "include",
          "store",
          "metadata",
          "user",
          "truncation",
          "service_tier"
        ],
        "validation": {
          "temperature": {"type": "number", "min": 0, "max": 2},
          "top_p": {"type": "number", "min": 0, "max": 1},
          "max_output_tokens": {"type": "integer", "min": 1}
        }
      },
      "capabilities": {
        "text_delta": true,
        "tool_calls": true,
        "tool_results": true,
        "usage": true,
        "refusal": true,
        "reasoning_summary": true,
        "encrypted_reasoning": true,
        "thinking": false,
        "thinking_signature": false,
        "image_generation": true,
        "advanced_tool_events": true,
        "advanced_event_passthrough": true
      },
      "reasoning": {
        "default": "metadata",
        "encrypted_reasoning": "passthrough",
        "reasoning_summary": "passthrough",
        "thinking": "passthrough",
        "thinking_signature": "passthrough"
      }
    },
    "codex_responses": {
      "base_protocol": "openai_responses",
      "events": {},
      "request_params": {
        "unsupported": [
          "metadata"
        ]
      },
      "capabilities": {
        "encrypted_reasoning": true,
        "image_generation": true,
        "advanced_tool_events": true
      },
      "reasoning": {
        "encrypted_reasoning": "passthrough",
        "reasoning_summary": "metadata"
      }
    },
    "anthropic_messages": {
      "events": {
        "created": {
          "name": "message_start",
          "data_path": "message"
        },
        "text_delta": {
          "name": "content_block_delta",
          "delta_path": "delta.text",
          "condition": {
            "delta.type": "text_delta"
          }
        },
        "tool_call_delta": {
          "name": "content_block_delta",
          "delta_path": "delta.partial_json",
          "condition": {
            "delta.type": "input_json_delta"
          }
        },
        "tool_call_started": {
          "name": "content_block_start",
          "condition": {
            "content_block.type": "tool_use"
          }
        },
        "output_item_done": {
          "name": "content_block_stop"
        },
        "usage": {
          "name": "message_delta",
          "data_path": "usage"
        },
        "completed": {
          "name": "message_stop"
        },
        "incomplete": {
          "name": "message_delta",
          "condition": {
            "delta.stop_reason": "max_tokens"
          }
        },
        "error": {
          "name": "error",
          "data_path": "error"
        },
        "thinking_delta": {
          "name": "content_block_delta",
          "delta_path": "delta.thinking",
          "condition": {
            "delta.type": "thinking_delta"
          }
        },
        "thinking_signature_delta": {
          "name": "content_block_delta",
          "delta_path": "delta.signature",
          "condition": {
            "delta.type": "signature_delta"
          }
        }
      },
      "param_mappings": [
        {
          "canonical": "stream",
          "upstream": "stream"
        },
        {
          "canonical": "temperature",
