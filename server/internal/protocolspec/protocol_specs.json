        },
        {
          "canonical": "top_p",
          "upstream": "top_p"
        },
        {
          "canonical": "top_k",
          "upstream": "top_k"
        },
        {
          "canonical": "metadata",
          "upstream": "metadata"
        },
        {
          "canonical": "stop_sequences",
          "upstream": "stop_sequences"
        },
        {
          "canonical": "thinking",
          "upstream": "thinking"
        },
        {
          "canonical": "output_config",
          "upstream": "output_config"
        }
      ],
      "request_params": {
        "supported": [
          "model",
          "messages",
          "system",
          "stream",
          "max_tokens",
          "temperature",
          "top_p",
          "top_k",
          "tools",
          "tool_choice",
          "metadata",
          "stop_sequences",
          "thinking",
          "output_config"
        ],
        "validation": {
          "temperature": {"type": "number", "min": 0, "max": 1},
          "top_p": {"type": "number", "min": 0, "max": 1},
          "top_k": {"type": "integer", "min": 1},
          "max_tokens": {"type": "integer", "min": 1}
        }
      },
      "capabilities": {
        "text_delta": true,
        "tool_calls": true,
        "tool_results": true,
        "usage": true,
        "thinking": true,
        "thinking_signature": true,
        "advanced_tool_events": true
      },
      "reasoning": {
        "default": "metadata",
        "encrypted_reasoning": "strip",
        "reasoning_summary": "metadata",
        "thinking": "passthrough",
        "thinking_signature": "passthrough"
      }
    },
