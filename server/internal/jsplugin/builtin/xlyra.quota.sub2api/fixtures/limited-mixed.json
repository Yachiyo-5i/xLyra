    "result": {
      "kind": "mixed",
      "entries": [
        {"label": "balance", "unit": "usd", "limit": 20, "used": 7.5, "remaining": 12.5},
        {"label": "5h", "unit": "requests", "limit": 100, "used": 3, "remaining": 97}
      ]
    }
  }
