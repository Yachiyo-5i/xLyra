{
  "name": "quota limited with rate windows",
  "ctx": {"siteType": "sub2api", "baseURL": "https://relay.example", "credentialType": "api_key", "now": 1791331200000},
  "responses": [{
    "match": {"method": "GET", "path": "/v1/usage"},
    "status": 200,
    "json": {
      "mode": "quota_limited",
